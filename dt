#!/usr/bin/env bash
# Wrapper: runs the DeepTutor CLI with the exam DB stored inside the repo (study/exam.db)
ROOT="$(cd "$(dirname "$0")" && pwd)"
export DEEPTUTOR_EXAM_DB="${DEEPTUTOR_EXAM_DB:-$ROOT/study/exam.db}"
[ -x "$ROOT/DeepTutor/.venv/bin/deeptutor" ] || "$ROOT/setup.sh"
# make relative file arguments absolute (we cd into DeepTutor below)
args=()
for a in "$@"; do if [ -e "$a" ]; then args+=("$(realpath "$a")"); else args+=("$a"); fi; done
cd "$ROOT/DeepTutor" && exec .venv/bin/deeptutor "${args[@]}"
