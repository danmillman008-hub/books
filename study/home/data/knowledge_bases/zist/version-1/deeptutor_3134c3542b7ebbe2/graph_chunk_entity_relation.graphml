  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="فناوری دنای نوترکیب">
  <data key="d0">فناوری دنای نوترکیب</data>
  <data key="d1">method</data>
  <data key="d2">فناوری تولید داروهای مطمئن و مؤثر که برخلاف فراورده‌های غیرانسانی پاسخ ایمنی ایجاد نمی‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="انسولین">
  <data key="d0">انسولین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">هورمون فعال از دو زنجیرهٔ کوتاه پلی‌پپتیدی A و B متصل به هم؛ در پستانداران به‌صورت پیش‌هورمون ساخته می‌شود؛ از لوزالمعدهٔ گاو یا با مهندسی ژنتیک در باکتری تهیه می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پیش‌هورمون انسولین">
  <data key="d0">پیش‌هورمون انسولین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">شکل اولیهٔ تک‌مولکولی انسولین در پستانداران.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تولید واکسن">
  <data key="d0">تولید واکسن</data>
  <data key="d1">method</data>
  <data key="d2">روش‌های قبلی: ضعیف‌کردن یا کشتن میکروب یا غیرفعال‌کردن سم؛ واکسن باید ایمنی را تحریک کند ولی بیماری ایجاد نکند؛ خطا در تولید ممکن است بیماری ایجاد کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="ژن‌درمانی">
  <data key="d0">ژن‌درمانی</data>
  <data key="d1">method</data>
  <data key="d2">قراردادن نسخهٔ سالم ژن در یاخته‌های فرد دارای نسخهٔ ناقص: یاخته‌ها خارج، ژن سالم با ناقل وارد و یاخته‌ها به بدن بازگردانده می‌شوند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اولین ژن‌درمانی موفق">
  <data key="d0">اولین ژن‌درمانی موفق</data>
  <data key="d1">event</data>
  <data key="d2">سال ۱۹۹۰ برای دختر ۴ ساله با نقص ژن آنزیم مهم دستگاه ایمنی؛ لنفوسیت‌ها جدا، کشت و ژن کارآمد منتقل شد؛ چون عمر لنفوسیت‌ها کوتاه است دریافت متناوب لازم بود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="لنفوسیت">
  <data key="d0">لنفوسیت</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاختهٔ ایمنی که در اولین ژن‌درمانی مهندسی و به بیمار بازگردانده شد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تشخیص بیماری با فناوری دنا">
  <data key="d0">تشخیص بیماری با فناوری دنا</data>
  <data key="d1">method</data>
  <data key="d2">شناسایی نوکلئیک اسید عامل بیماری‌زا برای تشخیص پیش از ظهور علائم و در مقادیر کم عامل بیماری‌زا.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="جانوران تراژنی">
  <data key="d0">جانوران تراژنی</data>
  <data key="d1">creature</data>
  <data key="d2">جانورانی برای مطالعهٔ عملکرد ژن‌ها (مثل عوامل رشد)، مدل بیماری‌های انسانی (سرطان، آلزایمر، ام‌اس) و تولید پروتئین انسانی یا دارو، مثل شیر غنی از پروتئین انسانی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-007</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="گیاهان C3">
  <data key="d0">گیاهان C3</data>
  <data key="d1">concept</data>
  <data key="d2">مانند گل سرخ و اغلب گیاهان؛ چرخهٔ کالوین در یاختهٔ میانبرگ؛ روزنه روز باز و شب بسته؛ سازشی برای غلبه بر تنفس نوری ندارند؛ تثبیت CO2 یک‌مرحله‌ای.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="گیاهان C4">
  <data key="d0">گیاهان C4</data>
  <data key="d1">concept</data>
  <data key="d2">مانند ذرت؛ چرخهٔ کالوین در یاختهٔ غلاف آوندی؛ روزنه روز ابتدا باز و با نور و دمای زیاد بسته، شب بسته؛ تفکیک مکانی تثبیت CO2 در دو مرحله.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تنفس نوری">
  <data key="d0">تنفس نوری</data>
  <data key="d1">concept</data>
  <data key="d2">فرایندی که گیاهان C4 و CAM با تفکیک مکانی یا زمانی بر آن غلبه می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="چرخهٔ کالوین">
  <data key="d0">چرخهٔ کالوین</data>
  <data key="d1">concept</data>
  <data key="d2">مرحلهٔ تثبیت کربن فتوسنتز در بستره.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="زنجیرهٔ انتقال الکترون راکیزه">
  <data key="d0">زنجیرهٔ انتقال الکترون راکیزه</data>
  <data key="d1">concept</data>
  <data key="d2">در غشای داخلی میتوکندری، یک نوع زنجیره با ۵ نوع پروتئین، وابسته به نور نیست و شب و روز فعال است؛ دهندهٔ الکترون NADH و FADH2 و پذیرندهٔ نهایی O2؛ O2 مصرف و آب تولید می‌شود؛ پروتون با ۳ نوع پمپ از بستره به فضای بین‌غشایی پمپ می‌شود؛ ATP در بستره ساخته می‌شود با انرژی اولیه از مواد آلی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="زنجیرهٔ انتقال الکترون سبزدیسه">
  <data key="d0">زنجیرهٔ انتقال الکترون سبزدیسه</data>
  <data key="d1">concept</data>
  <data key="d2">در غشای تیلاکوئید، دو نوع زنجیره، وابسته به نور و فقط در روز؛ دهندهٔ الکترون آب و پذیرندهٔ نهایی NADP+؛ O2 تولید و آب مصرف می‌شود؛ NADPH تولید؛ پروتون با ۱ نوع پمپ از بستره به درون تیلاکوئید؛ ATP در سطح خارجی تیلاکوئید با انرژی نور.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تیغهٔ میانی">
  <data key="d0">تیغهٔ میانی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">تک‌لایه از جنس پکتین، دورترین بخش دیواره از پروتوپلاست، هم‌زمان با تقسیم یاخته ساخته می‌شود و دو یاخته را به هم متصل می‌کند؛ در ژله‌ای شدن مؤثر است.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="دیوارهٔ نخستین">
  <data key="d0">دیوارهٔ نخستین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یک یا چند لایه با سلولز غیرجهت‌دار بین پروتئین‌ها و پلی‌ساکاریدها، در همهٔ بافت‌های گیاهی، قابل گسترش هم‌زمان با رشد یاخته و به یاخته شکل می‌دهد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="دیوارهٔ پسین">
  <data key="d0">دیوارهٔ پسین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">چندلایه با سلولز جهت‌دار، ضخیم‌ترین، نزدیک‌ترین به پروتوپلاست، در مراحل پایانی رشد ساخته می‌شود، استحکام می‌دهد و قابلیت رسوب لیگنین دارد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-008&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="چوبی شدن">
  <data key="d0">چوبی شدن</data>
  <data key="d1">concept</data>
  <data key="d2">افزودن لیگنین (مادهٔ آلی) به تمام سطح دیوارهٔ آوند چوبی؛ رشد یاخته را متوقف و اغلب سبب مرگ می‌شود؛ هدف استحکام بیشتر؛ در ریشه، ساقه، برگ و میوه.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کوتینی شدن">
  <data key="d0">کوتینی شدن</data>
  <data key="d1">concept</data>
  <data key="d2">افزودن کوتین به سطح خارجی روپوست اندام‌های هوایی جوان برای کاهش تبخیر و دفاع؛ رشد یاخته را متوقف نمی‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="چوب‌پنبه‌ای شدن">
  <data key="d0">چوب‌پنبه‌ای شدن</data>
  <data key="d1">concept</data>
  <data key="d2">افزودن چوب‌پنبه به تمام سطوح دیواره در پوست ساقه و ریشهٔ چوبی دولپه‌ای‌ها و آندودرم ریشهٔ نهان‌دانگان؛ اغلب سبب مرگ؛ کاهش تبخیر.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کانی شدن">
  <data key="d0">کانی شدن</data>
  <data key="d1">concept</data>
  <data key="d2">افزودن ترکیبات معدنی مانند سیلیس به سطح خارجی روپوست برگ گندم با نقش دفاعی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="ژله‌ای شدن">
  <data key="d0">ژله‌ای شدن</data>
  <data key="d1">concept</data>
  <data key="d2">جذب آب در تیغهٔ میانی، مانند دانهٔ به و تخم شربتی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="لیگنین">
  <data key="d0">لیگنین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مادهٔ آلی چوب که در دیوارهٔ پسین رسوب می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="آندودرم">
  <data key="d0">آندودرم</data>
  <data key="d1">naturalobject</data>
  <data key="d2">درونی‌ترین لایهٔ پوست ریشه که دیوارهٔ آن چوب‌پنبه‌ای می‌شود؛ در ریشهٔ تک‌لپه و دولپه وجود دارد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تک‌لپه‌ای">
  <data key="d0">تک‌لپه‌ای</data>
  <data key="d1">concept</data>
  <data key="d2">مانند خرما و گندم؛ ریشهٔ افشان، ساقهٔ هوایی بدون انشعاب، برگ نواری بدون دمبرگ با رگبرگ موازی، گلبرگ مضرب ۳؛ ریشه دارای مغز، استوانهٔ آوندی قطورتر، آوند چوب دایره‌ای، بدون رشد پسین؛ میانبرگ فقط اسفنجی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="دولپه‌ای">
  <data key="d0">دولپه‌ای</data>
  <data key="d1">concept</data>
  <data key="d2">مانند پروانه‌واران؛ ریشهٔ مستقیم، ساقهٔ منشعب، برگ با پهنک و دمبرگ و رگبرگ منشعب، گلبرگ مضرب ۴ یا ۵؛ ریشه بدون مغز با آوند چوب ستاره‌ای و آبکش بین بازوها؛ ممکن است رشد پسین داشته باشد؛ میانبرگ نرده‌ای و اسفنجی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-009</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="روزنهٔ هوایی">
  <data key="d0">روزنهٔ هوایی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">در ساقه‌های جوان و برگ‌ها، در روپوست زیرین بیشتر از رویی، در تک‌لپه و دولپه.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="روزنهٔ آبی">
  <data key="d0">روزنهٔ آبی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">در تک‌لپه‌ای‌ها در نوک برگ و در دولپه‌ای‌ها در حاشیهٔ برگ.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="سرلاد نخستین ریشه">
  <data key="d0">سرلاد نخستین ریشه</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مریستم نزدیک نوک ریشه که بافت روپوستی، زمینه‌ای و آوندی می‌سازد و طول و عرض ریشه را زیاد می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="سرلاد نخستین ساقه">
  <data key="d0">سرلاد نخستین ساقه</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مریستم درون جوانه‌ها و بین دو گره که هر سه سامانه را می‌سازد و طول و عرض ساقه را زیاد می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="بن‌لاد آوندساز">
  <data key="d0">بن‌لاد آوندساز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مریستم پسین در سامانهٔ آوندی دولپه‌ای‌ها که به بیرون آبکش و به درون چوب می‌سازد و عرض را زیاد می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="بن‌لاد چوب‌پنبه‌ساز">
  <data key="d0">بن‌لاد چوب‌پنبه‌ساز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مریستم پسین در بخش زمینه‌ای پوست که به بیرون چوب‌پنبه و به درون پارانشیم می‌سازد و پیراپوست را تشکیل می‌دهد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پیراپوست">
  <data key="d0">پیراپوست</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پوشش حاصل از فعالیت بن‌لاد چوب‌پنبه‌ساز.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پارانشیم">
  <data key="d0">پارانشیم</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاختهٔ زمینه‌ای زنده با دیوارهٔ نخستین نازک، چندوجهی، دارای پلاسمودسم، توانایی تقسیم؛ نقش فتوسنتز، ذخیره و ترمیم زخم؛ در پوست، ساقه، ریشه و میانبرگ.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کلانشیم">
  <data key="d0">کلانشیم</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاختهٔ زمینه‌ای زنده، کشیده، با دیوارهٔ نخستین ضخیم غیریکنواخت بدون لیگنین، معمولاً زیر روپوست، مانع رشد اندام نمی‌شود؛ استحکام.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="فیبر">
  <data key="d0">فیبر</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاختهٔ استحکامی کشیده با دیوارهٔ پسین چوبی، اغلب مرده، مانع رشد، در بافت آوندی و پوست.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اسکلرئید">
  <data key="d0">اسکلرئید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاختهٔ استحکامی کوتاه با دیوارهٔ پسین چوبی، اغلب مرده، در پوست و میوه‌هایی مانند گلابی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="لایهٔ ریشه‌زا">
  <data key="d0">لایهٔ ریشه‌زا</data>
  <data key="d1">naturalobject</data>
  <data key="d2">خارجی‌ترین بخش استوانهٔ آوندی ریشه که در ایجاد فشار ریشه‌ای نقش دارد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-010</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تراکئید">
  <data key="d0">تراکئید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاختهٔ آوند چوبی مرده، بدون هسته، دراز، باریک و دوکی، با دیوارهٔ پسین چوبی و دیوارهٔ عرضی؛ سرعت شیرهٔ خام پایین.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="عناصر آوندی">
  <data key="d0">عناصر آوندی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌های آوند چوبی مرده و کوتاه بدون دیوارهٔ عرضی با دیوارهٔ پسین چوبی؛ سرعت شیرهٔ خام بالا.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="یاخته‌های آبکشی">
  <data key="d0">یاخته‌های آبکشی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌های آوند آبکش زنده بدون هسته، دراز، فقط دیوارهٔ نخستین، دارای دیوارهٔ عرضی؛ گلیکولیز و اکسایش پیرووات انجام می‌دهند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="میوهٔ حقیقی">
  <data key="d0">میوهٔ حقیقی</data>
  <data key="d1">concept</data>
  <data key="d2">میوهٔ حاصل از رشد تخمدان، مانند هلو و پرتقال.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="میوهٔ کاذب">
  <data key="d0">میوهٔ کاذب</data>
  <data key="d1">concept</data>
  <data key="d2">میوهٔ حاصل از رشد بخش‌هایی غیر از تخمدان، مانند سیب.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="زمین‌ساقه">
  <data key="d0">زمین‌ساقه</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ساقهٔ افقی زیرزمینی مانند زنبق با جوانه‌های انتهایی و جانبی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="غده">
  <data key="d0">غده</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ساقهٔ زیرزمینی مانند سیب‌زمینی که جوانه‌هایش نشاستهٔ آمیلوپلاست را مصرف می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پیاز">
  <data key="d0">پیاز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ساقهٔ تکمه‌مانند زیرزمینی با برگ‌های خوراکی، مانند پیاز خوراکی، نرگس و لاله.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="ساقهٔ رونده">
  <data key="d0">ساقهٔ رونده</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ساقهٔ افقی روی خاک مانند توت‌فرنگی که در گره‌ها گیاه جدید ایجاد می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="جیبرلین">
  <data key="d0">جیبرلین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">هورمون از رویان دانهٔ غلات و قارچ جیبرلا؛ رشد طولی ساقه، رشد میوه، رویش دانه و تجزیهٔ ذخایر دانه؛ افزایش آن در بیماری دانه‌رست برنج باعث خم شدن گیاه می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="آبسیزیک اسید">
  <data key="d0">آبسیزیک اسید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">هورمون بستن روزنه‌ها و کاهش تعرق و ممانعت از رویش جوانه‌ها.&lt;SEP&gt;هورمون تولیدشده در شرایط نامساعد؛ بستن روزنه‌ها و کاهش تعرق، ممانعت از رویش جوانه‌ها و رشد دانه.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="عامل نارنجی">
  <data key="d0">عامل نارنجی</data>
  <data key="d1">artifact</data>
  <data key="d2">مخلوطی از اکسین‌ها که در سرطان‌زایی و نقص مادرزادی مؤثر است.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-011</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اتیلن">
  <data key="d0">اتیلن</data>
  <data key="d1">naturalobject</data>
  <data key="d2">هورمون گازی از بافت آسیب‌دیده، میوهٔ رسیده، جوانهٔ جانبی و سوخت فسیلی؛ ریزش برگ با آنزیم تجزیه‌کننده در محل دمبرگ، رسیدن و خراب شدن و ریزش میوه؛ تحت اثر اکسین در چیرگی راسی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="سالیسیلیک اسید">
  <data key="d0">سالیسیلیک اسید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">هورمون یاخته‌های آلوده به ویروس که با فعال‌کردن آنزیم‌ها مرگ برنامه‌ریزی‌شده را القا و از تکثیر ویروس جلوگیری می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="مرگ برنامه‌ریزی‌شده">
  <data key="d0">مرگ برنامه‌ریزی‌شده</data>
  <data key="d1">concept</data>
  <data key="d2">مرگ یاخته‌های آلوده که از گسترش ویروس جلوگیری می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="چیرگی راسی">
  <data key="d0">چیرگی راسی</data>
  <data key="d1">concept</data>
  <data key="d2">غلبهٔ جوانهٔ راسی بر جوانه‌های جانبی که اکسین و اتیلن در آن نقش دارند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تک‌یاخته‌ای‌ها">
  <data key="d0">تک‌یاخته‌ای‌ها</data>
  <data key="d1">creature</data>
  <data key="d2">جاندارانی که تبادل گاز، تغذیه و دفع را از سطح یاخته انجام می‌دهند و دستگاه گردش مواد ندارند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پارامسی">
  <data key="d0">پارامسی</data>
  <data key="d1">creature</data>
  <data key="d2">آغازی مژک‌دار یوکاریوتی با گوارش فقط درون‌یاخته‌ای؛ مژک‌ها غذا را به حفرهٔ دهانی می‌برند؛ آب اضافی با کریچه‌های انقباضی دفع می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کریچهٔ غذایی">
  <data key="d0">کریچهٔ غذایی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">واکوئولی که با درون‌بری در انتهای حفرهٔ دهانی پارامسی تشکیل می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کافنده‌تن">
  <data key="d0">کافنده‌تن</data>
  <data key="d1">naturalobject</data>
  <data key="d2">لیزوزوم؛ اندامک دارای آنزیم گوارشی که به کریچهٔ غذایی می‌پیوندد و کریچهٔ گوارشی می‌سازد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کریچهٔ دفعی">
  <data key="d0">کریچهٔ دفعی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">کریچهٔ حاوی مواد گوارش‌نیافته که با برون‌رانی از منفذ دفعی خارج می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کریچهٔ انقباضی">
  <data key="d0">کریچهٔ انقباضی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">کریچه‌ای در پارامسی که آب واردشده با اسمز و مواد دفعی را خارج می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کرم کدو">
  <data key="d0">کرم کدو</data>
  <data key="d1">creature</data>
  <data key="d2">کرم پهن بدون دهان و دستگاه گوارش که مواد مغذی را از سطح بدن جذب می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تبادل گاز با انتشار">
  <data key="d0">تبادل گاز با انتشار</data>
  <data key="d1">concept</data>
  <data key="d2">در تک‌یاخته‌ای‌ها، کرم‌های پهن و کیسه‌تنان گاز با انتشار مبادله می‌شود و ساختار تنفسی ویژه ندارند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-012</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اسفنج">
  <data key="d0">اسفنج</data>
  <data key="d1">creature</data>
  <data key="d2">بی‌مهره‌ای که به‌جای گردش مواد، آب از سوراخ‌های دیواره وارد حفره و از سوراخ بزرگ‌تر خارج می‌شود؛ یاخته‌های یقه‌دار تاژک‌دار آب را حرکت می‌دهند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="یاخته‌های یقه‌دار">
  <data key="d0">یاخته‌های یقه‌دار</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌های تاژک‌دار اسفنج که عامل حرکت آب در حفرهٔ میانی‌اند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="نرم‌تنان خشکی‌زی">
  <data key="d0">نرم‌تنان خشکی‌زی</data>
  <data key="d1">creature</data>
  <data key="d2">مانند حلزون و لیسه که با شش تنفس می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کیسه‌تنان">
  <data key="d0">کیسه‌تنان</data>
  <data key="d1">creature</data>
  <data key="d2">مرجان‌ها، هیدر آب شیرین، عروس دریایی و شقایق دریایی؛ گوارش در حفرهٔ گوارشی منشعب که گردش مواد و انتقال گاز را هم انجام می‌دهد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="حفرهٔ گوارشی">
  <data key="d0">حفرهٔ گوارشی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">کیسهٔ منشعب پر از مایع در کیسه‌تنان و پلاناریا که گوارش، گردش مواد و انتقال گاز را انجام می‌دهد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="هیدر">
  <data key="d0">هیدر</data>
  <data key="d1">creature</data>
  <data key="d2">کیسه‌تن آب شیرین با ساده‌ترین ساختار عصبی یعنی شبکهٔ عصبی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="شبکهٔ عصبی">
  <data key="d0">شبکهٔ عصبی</data>
  <data key="d1">concept</data>
  <data key="d2">نورون‌های پراکنده در دیوارهٔ بدن هیدر که تحریک را به همهٔ سطح بدن منتشر و یاخته‌های ماهیچه‌ای را تحریک می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اسکلت آب‌ایستایی">
  <data key="d0">اسکلت آب‌ایستایی</data>
  <data key="d1">concept</data>
  <data key="d2">اسکلت ناشی از تجمع مایع درون بدن؛ در عروس دریایی با خروج آب جانور در جهت مخالف حرکت می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="عروس دریایی">
  <data key="d0">عروس دریایی</data>
  <data key="d1">creature</data>
  <data key="d2">کیسه‌تن دارای اسکلت آب‌ایستایی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پلاناریا">
  <data key="d0">پلاناریا</data>
  <data key="d1">creature</data>
  <data key="d2">کرم پهن که انشعابات حفرهٔ گوارشی به همهٔ بدن نفوذ می‌کند؛ سامانهٔ دفعی پروتونفریدی دارد.&lt;SEP&gt;کرم پهن با دو گرهٔ عصبی مغزی در سر و دو طناب عصبی متصل با رشته‌های عرضی به شکل نردبان.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پروتونفریدی">
  <data key="d0">پروتونفریدی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">شبکهٔ کانال‌های دفعی با چند منفذ و یاخته‌های شعله‌ای که کار اصلی‌اش دفع آب اضافی است؛ بیشتر دفع نیتروژن از سطح بدن است.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="یاخته‌های شعله‌ای">
  <data key="d0">یاخته‌های شعله‌ای</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌های مژک‌دار در طول کانال‌های پروتونفریدی که مایعات را به کانال‌ها هدایت می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-013</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="دستگاه عصبی نردبانی">
  <data key="d0">دستگاه عصبی نردبانی</data>
  <data key="d1">concept</data>
  <data key="d2">مغز و دو طناب عصبی و رشته‌های بین آن‌ها بخش مرکزی، و رشته‌های جانبی بخش محیطی دستگاه عصبی پلاناریا را می‌سازند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="گرهٔ عصبی">
  <data key="d0">گرهٔ عصبی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مجموعه‌ای از جسم یاخته‌ای نورون‌ها.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کرم کبد">
  <data key="d0">کرم کبد</data>
  <data key="d1">creature</data>
  <data key="d2">کرم پهن هرمافرودیت که هر فرد تخمک‌های خود را بارور می‌کند (خودلقاحی).</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="هرمافرودیت">
  <data key="d0">هرمافرودیت</data>
  <data key="d1">concept</data>
  <data key="d2">داشتن هر دو دستگاه تولیدمثلی نر و ماده در یک فرد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کرم خاکی">
  <data key="d0">کرم خاکی</data>
  <data key="d1">creature</data>
  <data key="d2">کرم حلقوی با تنفس پوستی از طریق شبکهٔ مویرگی زیرپوستی، گردش خون بسته، دفع متانفریدی و هرمافرودیت با لقاح دوطرفی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="گردش خون بسته">
  <data key="d0">گردش خون بسته</data>
  <data key="d1">concept</data>
  <data key="d2">ساده‌ترین نوع آن در کرم خاکی: رگ پشتی قلب اصلی است و خون را از عقب به جلو می‌راند؛ پنج جفت کمان رگی قلب کمکی‌اند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کمان رگی">
  <data key="d0">کمان رگی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پنج جفت رگ اطراف لولهٔ گوارش در جلوی بدن کرم خاکی که قلب کمکی‌اند و خون را از بالا به پایین می‌برند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="متانفریدی">
  <data key="d0">متانفریدی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">سامانهٔ دفعی پیشرفته‌تر در کرم‌های حلقوی و نرم‌تنان؛ لولهٔ دوسرباز با قیف مژک‌دار در جلو و مثانه در انتها که به منفذ ادراری می‌رسد؛ هر حلقهٔ کرم خاکی یک جفت دارد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="لقاح دوطرفی">
  <data key="d0">لقاح دوطرفی</data>
  <data key="d1">concept</data>
  <data key="d2">در کرم خاکی اسپرم هر کرم تخمک‌های کرم دیگر را بارور می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="حشرات">
  <data key="d0">حشرات</data>
  <data key="d1">creature</data>
  <data key="d2">بندپایانی با بدن سه‌قسمتی (سر، سینه، شکم)، شش پا و اغلب بال؛ دستگاه گوارش کامل با مخرج.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="چینه‌دان">
  <data key="d0">چینه‌دان</data>
  <data key="d1">naturalobject</data>
  <data key="d2">بخش حجیم انتهای مری ملخ که غذا در آن ذخیره و نرم می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-014&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-018</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پیش‌معده">
  <data key="d0">پیش‌معده</data>
  <data key="d1">naturalobject</data>
  <data key="d2">بخش کوچک لولهٔ گوارش ملخ با دندانه‌هایی برای خردکردن بیشتر غذا؛ آنزیم‌های معده به آن وارد می‌شوند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کیسه‌های معده">
  <data key="d0">کیسه‌های معده</data>
  <data key="d1">naturalobject</data>
  <data key="d2">کیسه‌هایی که آنزیم ترشح می‌کنند و گوارش برون‌یاخته‌ای در آن‌ها کامل می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="تنفس نایدیسی">
  <data key="d0">تنفس نایدیسی</data>
  <data key="d1">concept</data>
  <data key="d2">تنفس حشرات با لوله‌های منشعب نایدیس که با منافذ تنفسی باز می‌شوند؛ انشعابات پایانی بن‌بست و دارای مایع‌اند؛ تبادل با انتشار؛ هوا دوطرفه؛ حشرات گلبول قرمز، هموگلوبین و کربنیک انیدراز ندارند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="نایدیس">
  <data key="d0">نایدیس</data>
  <data key="d1">naturalobject</data>
  <data key="d2">لولهٔ تنفسی منشعب حشرات که قطورترین بخشش در محل منفذ است.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="لوله‌های مالپیگی">
  <data key="d0">لوله‌های مالپیگی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">سامانهٔ دفعی متصل به رودهٔ حشرات؛ پتاسیم و کلر از همولنف ترشح، آب با اسمز وارد و اوریک اسید ترشح می‌شود؛ محتوا به روده تخلیه و آب و یون بازجذب می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اوریک اسید">
  <data key="d0">اوریک اسید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مادهٔ دفعی نیتروژن‌دار حشرات که همراه مواد گوارش‌نیافته از مخرج دفع می‌شود.&lt;SEP&gt;از سوخت‌وساز اسیدهای نوکلئیک؛ انحلال کم، تمایل به رسوب، ایجاد سنگ کلیه و نقرس؛ پرندگان و حشرات دفع می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-027</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="همولنف">
  <data key="d0">همولنف</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مایع گردشی حشرات.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="اسکلت بیرونی">
  <data key="d0">اسکلت بیرونی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">اسکلت کیتینی حشرات با نقش حرکتی و حفاظتی که اندازهٔ حشرات را محدود می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="کیتین">
  <data key="d0">کیتین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">جنس اسکلت بیرونی حشرات.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="چشم مرکب">
  <data key="d0">چشم مرکب</data>
  <data key="d1">naturalobject</data>
  <data key="d2">چشم حشرات از واحدهای بینایی متعدد که هر کدام قرنیه، عدسی و چند گیرندهٔ نوری دارند؛ مغز تصویر موزاییکی می‌سازد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="لقاح داخلی">
  <data key="d0">لقاح داخلی</data>
  <data key="d1">concept</data>
  <data key="d2">لقاح در بدن ماده که همهٔ حشرات دارند و نیازمند اندام‌های تخصص‌یافته است.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-015</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="دستگاه عصبی حشرات">
  <data key="d0">دستگاه عصبی حشرات</data>
  <data key="d1">concept</data>
  <data key="d2">بخش مرکزی شامل مغز (چند گرهٔ جوش‌خورده) و طناب عصبی شکمی با یک گره در هر بند؛ بخش محیطی رشته‌های خارج‌شده؛ طولانی‌ترین عصب به پاهای عقبی می‌رود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="طناب عصبی شکمی">
  <data key="d0">طناب عصبی شکمی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">طناب عصبی حشرات که در هر بند یک گره دارد که ماهیچه‌های آن بند را تنظیم می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="مگس">
  <data key="d0">مگس</data>
  <data key="d1">creature</data>
  <data key="d2">حشره‌ای با گیرنده‌های شیمیایی در موهای حسی پاها.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="جیرجیرک">
  <data key="d0">جیرجیرک</data>
  <data key="d1">creature</data>
  <data key="d2">حشره‌ای با پردهٔ صماخ روی محفظهٔ هوا در پاهای جلویی که گیرنده‌های مکانیکی صدا را تحریک می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="فرومون">
  <data key="d0">فرومون</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مادهٔ شیمیایی ارتباطی؛ زنبورها برای هشدار خطر شکارچی از آن استفاده می‌کنند.&lt;SEP&gt;مارها برای جفت‌یابی و گربه‌ها برای تعیین قلمرو از فرومون استفاده می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-018</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پروانهٔ مونارک">
  <data key="d0">پروانهٔ مونارک</data>
  <data key="d1">creature</data>
  <data key="d2">پروانه‌ای که هر سال هزاران کیلومتر از مکزیک تا جنوب کانادا مهاجرت می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="سخت‌پوستان">
  <data key="d0">سخت‌پوستان</data>
  <data key="d1">creature</data>
  <data key="d2">مواد دفعی نیتروژن‌دار را با انتشار از آبشش دفع می‌کنند؛ برخی (میگو و خرچنگ) غدد شاخکی دارند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="غدد شاخکی">
  <data key="d0">غدد شاخکی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">غده‌های دفعی میگو و خرچنگ که مایع را از حفرهٔ عمومی گرفته و از منفذ نزدیک شاخک دفع می‌کنند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="غذایابی بهینه">
  <data key="d0">غذایابی بهینه</data>
  <data key="d1">concept</data>
  <data key="d2">خرچنگ ساحلی صدف متوسط را ترجیح می‌دهد چون بیشترین انرژی خالص را دارد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="ستارهٔ دریایی">
  <data key="d0">ستارهٔ دریایی</data>
  <data key="d1">creature</data>
  <data key="d2">بی‌مهرهٔ آبزی با ساده‌ترین آبشش‌ها یعنی برجستگی‌های کوچک پراکندهٔ پوستی.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="مچنیکوف">
  <data key="d0">مچنیکوف</data>
  <data key="d1">person</data>
  <data key="d2">دانشمندی که در لارو شفاف ستارهٔ دریایی یاخته‌های آمیبی‌شکل بیگانه‌خوار را کشف کرد و با وارد کردن خرده‌خار گل رز نقش دفاعی آن‌ها را نشان داد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="بیگانه‌خواری">
  <data key="d0">بیگانه‌خواری</data>
  <data key="d1">concept</data>
  <data key="d2">خوردن میکروب و ذرات خارجی توسط یاخته‌های آمیبی‌شکل در دفاع.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="مهره‌داران">
  <data key="d0">مهره‌داران</data>
  <data key="d1">creature</data>
  <data key="d2">همه گردش بسته، کلیه، طناب عصبی پشتی با مغز در جلو و اسکلت درونی دارند؛ ایمنی اختصاصی اساساً در آن‌هاست؛ مغز پستانداران و پرندگان نسبتاً بزرگ‌تر است.&lt;SEP&gt;ماهی‌ها، دوزیستان، خزندگان، پرندگان و پستانداران.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-016&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="پمپ فشار مثبت">
  <data key="d0">پمپ فشار مثبت</data>
  <data key="d1">method</data>
  <data key="d2">سازوکار تهویهٔ قورباغه که با ماهیچه‌های دهان و حلق هوا را با فشار به شش‌ها می‌راند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="فشار منفی">
  <data key="d0">فشار منفی</data>
  <data key="d1">method</data>
  <data key="d2">سازوکار تهویهٔ انسان که هوا با مکش به شش‌ها وارد می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="قورباغه">
  <data key="d0">قورباغه</data>
  <data key="d1">creature</data>
  <data key="d2">دوزیستی که با پمپ فشار مثبت تهویه می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="گردش خون مضاعف">
  <data key="d0">گردش خون مضاعف</data>
  <data key="d1">concept</data>
  <data key="d2">خون در هر بار گردش دو بار از قلب می‌گذرد و قلب دو تلمبه است؛ جدایی کامل بطن‌ها حفظ فشار را آسان می‌کند.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017&lt;SEP&gt;doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-018</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="گردش خون ساده">
  <data key="d0">گردش خون ساده</data>
  <data key="d1">concept</data>
  <data key="d2">در ماهی و نوزاد دوزیستان خون در هر گردش یک بار از قلب دوحفره‌ای می‌گذرد؛ مزیت آن رساندن یک‌بارهٔ خون اکسیژن‌دار به همهٔ مویرگ‌هاست.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
  <data key="d6"></data>
</node>
<node id="جدایی کامل بطن‌ها">
  <data key="d0">جدایی کامل بطن‌ها</data>
  <data key="d1">concept</data>
  <data key="d2">در پرندگان، پستانداران و برخی خزندگان مانند کروکودیل؛ برای فشار خون بالا در جانوران با نیاز انرژی زیاد.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-017</data>
  <data key="d4">jozve_nokte_test_zist.pdf</data>
  <data key="d5">1790333582</data>
