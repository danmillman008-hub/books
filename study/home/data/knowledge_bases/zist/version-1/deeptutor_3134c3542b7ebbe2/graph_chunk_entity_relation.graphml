<node id="فصل ۸ رفتارهای جانوران">
  <data key="d0">فصل ۸ رفتارهای جانوران</data>
  <data key="d1">content</data>
  <data key="d2">فصل هشتم زیست ۳: انواع رفتارهای جانوران، چگونگی و علت آن‌ها از دیدگاه انتخاب طبیعی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-062&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-066</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
