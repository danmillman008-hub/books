</node>
<node id="ایدز">
  <data key="d0">ایدز</data>
  <data key="d1">event</data>
  <data key="d2">بیماری خطرناک بدون درمان قطعی که توانایی دفاع را از بین می‌برد؛ با استخراج دنای خون و تشخیص دنای ساخته‌شده از رنای ویروس زودهنگام شناسایی می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-061</data>
