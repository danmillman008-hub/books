  <data key="d0">جهش خاموش</data>
  <data key="d1">concept</data>
  <data key="d2">جهش جانشینی که رمز یک آمینواسید را به رمز دیگر همان آمینواسید تبدیل می‌کند و توالی آمینواسیدها تغییر نمی‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-028</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
