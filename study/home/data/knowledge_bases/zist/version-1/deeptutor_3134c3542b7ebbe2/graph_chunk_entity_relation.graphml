  <data key="d0">شبیه‌سازی</data>
  <data key="d1">method</data>
  <data key="d2">روشی برای جلوگیری از انقراض گونه‌ها؛ مثل شبیه‌سازی قوچ وحشی توسط پژوهشکدهٔ رویان.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-061</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
