  <data key="d1">naturalobject</data>
  <data key="d2">واکسن نوترکیب تولیدشده با مهندسی ژنتیک.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="تشخیص بیماری با زیست‌فناوری">
  <data key="d0">تشخیص بیماری با زیست‌فناوری</data>
  <data key="d1">method</data>
  <data key="d2">شناسایی نوکلئیک اسید عامل بیماری‌زا پیش از ظهور علائم.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-061</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
