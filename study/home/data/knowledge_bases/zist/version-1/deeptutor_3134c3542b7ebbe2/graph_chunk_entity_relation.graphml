  <data key="d0">تاریخچهٔ کشف دنا</data>
  <data key="d1">event</data>
  <data key="d2">۱۸۶۹ میشر، ۱۹۲۸ گریفیت، ۱۹۴۴ ایوری، ۱۹۵۰ چارگاف، ۱۹۵۲ فرانکلین و ویلکینز، ۱۹۵۳ واتسون و کریک.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-004</data>
