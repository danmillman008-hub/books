  <data key="d0">تنظیم در سطح فام‌تنی</data>
  <data key="d1">method</data>
  <data key="d2">تغییر میزان فشردگی فام‌تن برای تنظیم دسترسی رنابسپاراز به ژن.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-021</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
