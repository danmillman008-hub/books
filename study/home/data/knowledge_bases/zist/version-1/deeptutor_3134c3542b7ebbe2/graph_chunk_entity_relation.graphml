<edge source="سؤال ۱ کنکور ۱۴۰۵" target="شرطی‌شدن فعال">
  <data key="d7">1.0</data>
  <data key="d8">سؤال ۱ رفتار فیل سیرک را به‌عنوان شرطی‌شدن فعال بررسی می‌کند.</data>
  <data key="d9">مبحث سؤال</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
  <data key="d11">konkur1405_zist_booklet.md</data>
  <data key="d12">1790333149</data>
  <data key="d13"></data>
</edge>
<edge source="سؤال ۱ کنکور ۱۴۰۵" target="نقش‌پذیری">
  <data key="d7">1.0</data>
  <data key="d8">گزینهٔ «منحصراً در دورهٔ کوتاه» ویژگی نقش‌پذیری است و برای فیل سیرک نادرست است.</data>
  <data key="d9">گزینهٔ نادرست</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
  <data key="d11">konkur1405_zist_booklet.md</data>
  <data key="d12">1790333149</data>
  <data key="d13"></data>
</edge>
<edge source="شرطی‌شدن فعال" target="حل مسئله">
  <data key="d7">1.0</data>
  <data key="d8">حل مسئله مقایسهٔ موقعیت فعلی با تجربیات است و با آزمون و خطا تفاوت دارد.</data>
  <data key="d9">مقایسهٔ انواع یادگیری</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
  <data key="d11">konkur1405_zist_booklet.md</data>
  <data key="d12">1790333149</data>
  <data key="d13"></data>
</edge>
<edge source="سؤال ۲ کنکور ۱۴۰۵" target="لکهٔ زرد">
  <data key="d7">1.0</data>
  <data key="d8">سؤال ۲ ویژگی‌های لکهٔ زرد را با نقطهٔ کور مقایسه می‌کند.</data>
  <data key="d9">مبحث سؤال</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
  <data key="d11">konkur1405_zist_booklet.md</data>
  <data key="d12">1790333149</data>
  <data key="d13"></data>
</edge>
<edge source="سؤال ۲ کنکور ۱۴۰۵" target="قرنیه">
  <data key="d7">1.0</data>
  <data key="d8">قرنیه رگ ندارد، پس رگ‌های شبکیه مستقیماً به آن خون‌رسانی نمی‌کنند.</data>
  <data key="d9">گزینهٔ نادرست</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
  <data key="d11">konkur1405_zist_booklet.md</data>
  <data key="d12">1790333149</data>
  <data key="d13"></data>
</edge>
<edge source="لکهٔ زرد" target="نقطهٔ کور">
  <data key="d7">1.0</data>
  <data key="d8">لکهٔ زرد گیرندهٔ نوری دارد و روی محور نوری است ولی نقطهٔ کور گیرنده ندارد.</data>
  <data key="d9">مقایسه</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
  <data key="d11">konkur1405_zist_booklet.md</data>
  <data key="d12">1790333149</data>
  <data key="d13"></data>
</edge>
<edge source="سؤال ۳ کنکور ۱۴۰۵" target="خرزهره">
  <data key="d7">1.0</data>
  <data key="d8">سؤال ۳ ساختار برگ خرزهره را می‌سنجد.</data>
  <data key="d9">مبحث سؤال</data>
  <data key="d10">doc-91a869610b9c2a0b99b26167cf6e3ad3-chunk-000</data>
