  <data key="d1">naturalobject</data>
  <data key="d2">کربوهیدرات‌های غشای گویچهٔ قرمز که با واکنش آنزیمی (آنزیم A و آنزیم B) اضافه می‌شوند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-024</data>
  <data key="d4">zist3_textbook.md</data>
