  <data key="d1">concept</data>
  <data key="d2">جابه‌جایی قسمتی از فام‌تن به فام‌تن همتا که در آن دو نسخه از آن قسمت دیده می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-029</data>
