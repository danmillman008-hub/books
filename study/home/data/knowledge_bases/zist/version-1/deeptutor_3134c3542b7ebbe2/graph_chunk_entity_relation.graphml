<node id="پمپ سدیم-پتاسیم">
  <data key="d0">پمپ سدیم-پتاسیم</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پروتئین غشایی که یون‌های سدیم و پتاسیم را جابه‌جا می‌کند و فعالیت آنزیمی دارد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-010</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
