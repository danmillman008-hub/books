  <data key="d0">جوجه کاکایی</data>
  <data key="d1">creature</data>
  <data key="d2">جوجه‌ای که برای دریافت غذا به منقار والد نوک می‌زند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-062&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-063&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-064</data>
  <data key="d4">zist3_textbook.md</data>
