  <data key="d0">جهش کوچک</data>
  <data key="d1">concept</data>
  <data key="d2">جهشی که یک یا چند نوکلئوتید را تغییر می‌دهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-027&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-028</data>
