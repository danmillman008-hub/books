  <data key="d1">creature</data>
  <data key="d2">گوسفندی از تخمک لقاح‌یافتهٔ دارای دیسک نوترکیب که شیر حاوی پروتئین انسانی تولید می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-062</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
