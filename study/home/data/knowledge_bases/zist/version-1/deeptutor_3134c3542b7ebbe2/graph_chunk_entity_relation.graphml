  <data key="d13"></data>
</edge>
<edge source="توالی افزاینده" target="خمیدگی دنا">
  <data key="d7">1.0</data>
  <data key="d8">اتصال به افزاینده با خمیدگی دنا عوامل رونویسی را کنار هم می‌آورد و سرعت رونویسی را افزایش می‌دهد.</data>
  <data key="d9">کنار هم قرارگیری عوامل</data>
