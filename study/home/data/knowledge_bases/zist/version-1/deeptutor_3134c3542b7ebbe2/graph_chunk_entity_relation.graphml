<node id="اهمیت ناخالص‌ها">
  <data key="d0">اهمیت ناخالص‌ها</data>
  <data key="d1">concept</data>
  <data key="d2">نقش افراد ناخالص در تداوم گوناگونی، که با کم‌خونی داسی‌شکل توضیح داده می‌شود.</data>
  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-006</data>
