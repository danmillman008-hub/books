  <data key="d0">گونه‌زایی</data>
  <data key="d1">method</data>
  <data key="d2">ایجاد گونهٔ جدید با جدایی تولیدمثلی؛ دو نوع دگرمیهنی و هم‌میهنی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-035</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ارنست مایر">
  <data key="d0">ارنست مایر</data>
  <data key="d1">person</data>
  <data key="d2">ارائه‌دهندهٔ تعریف رایج گونه برای جانداران با تولیدمثل جنسی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-035</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گونه">
  <data key="d0">گونه</data>
  <data key="d1">concept</data>
  <data key="d2">جاندارانی که در طبیعت با هم آمیزش و زادهٔ زیستا و زایا ایجاد می‌کنند ولی با جانداران دیگر آمیزش موفقیت‌آمیز ندارند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-035</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گونه‌زایی دگرمیهنی">
  <data key="d0">گونه‌زایی دگرمیهنی</data>
  <data key="d1">method</data>
  <data key="d2">گونه‌زایی با جدایی جغرافیایی (کوه، دره، دریاچه) که شارش ژن را قطع می‌کند و با جهش، نوترکیبی و انتخاب طبیعی دو جمعیت متفاوت می‌شوند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-035&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گونه‌زایی هم‌میهنی">
  <data key="d0">گونه‌زایی هم‌میهنی</data>
  <data key="d1">method</data>
  <data key="d2">گونه‌زایی بدون جدایی جغرافیایی.&lt;SEP&gt;گونه‌زایی بدون جدایی جغرافیایی در یک زیستگاه؛ مثال پیدایش گیاهان چندلادی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-035&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="چندلادی">
  <data key="d0">چندلادی</data>
  <data key="d1">concept</data>
  <data key="d2">پلی‌پلوییدی؛ ناشی از خطای میوزی (جدا نشدن فام‌تن‌ها)؛ گیاه زیستا و زایا ولی بدون زادهٔ زایا با گونهٔ نیایی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="هوگو دووری">
  <data key="d0">هوگو دووری</data>
  <data key="d1">person</data>
  <data key="d2">دانشمندی که در اوایل ۱۹۰۰ در گل مغربی (2n=14) گیاه چارلادی با ۲۸ فام‌تن یافت.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گل مغربی">
  <data key="d0">گل مغربی</data>
  <data key="d1">creature</data>
  <data key="d2">گیاهی با 2n=14 که نمونهٔ چارلاد آن (4n) گونهٔ جدید شد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گیاه چارلاد">
  <data key="d0">گیاه چارلاد</data>
  <data key="d1">creature</data>
  <data key="d2">تتراپلوئید 4n که گامت دولاد می‌سازد؛ با خودلقاحی زایاست ولی آمیزش با گیاه 2n زادهٔ سه‌لاد نازا می‌دهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گیاه سه‌لاد">
  <data key="d0">گیاه سه‌لاد</data>
  <data key="d1">creature</data>
  <data key="d2">تریپلوئید 3n حاصل آمیزش چارلاد و دولاد؛ نازاست.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="خطای میوزی">
  <data key="d0">خطای میوزی</data>
  <data key="d1">event</data>
  <data key="d2">جدا نشدن فام‌تن‌ها در میوز که گامت با عدد فام‌تنی غیرطبیعی می‌سازد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فصل ۵ از ماده به انرژی">
  <data key="d0">فصل ۵ از ماده به انرژی</data>
  <data key="d1">content</data>
  <data key="d2">فصل پنجم زیست ۳ دربارهٔ آزاد شدن انرژی از مادهٔ مغذی در یاخته‌ها؛ طرح سؤال محاسباتی ممنوع است.&lt;SEP&gt;فصل پنجم دربارهٔ تأمین انرژی از غذا؛ پرسش آغازین: چرا ورزش گرما و عرق ایجاد می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-036&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-037</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ADP">
  <data key="d0">ADP</data>
  <data key="d1">naturalobject</data>
  <data key="d2">آدنوزین دی‌فسفات؛ ساخت ATP از ADP و فسفات انرژی می‌خواهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-037&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-042</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="AMP">
  <data key="d0">AMP</data>
  <data key="d1">naturalobject</data>
  <data key="d2">آدنوزین مونوفسفات.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-037</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ساخته شدن ATP در سطح پیش‌ماده">
  <data key="d0">ساخته شدن ATP در سطح پیش‌ماده</data>
  <data key="d1">method</data>
  <data key="d2">برداشتن فسفات از ترکیب فسفات‌دار و افزودن آن به ADP؛ مثل کرآتین فسفات در ماهیچه.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-037</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کرآتین فسفات">
  <data key="d0">کرآتین فسفات</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پیش‌ماده‌ای در ماهیچه که فسفاتش برای ساخت ATP به ADP منتقل می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-037</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ساخته شدن اکسایشی ATP">
  <data key="d0">ساخته شدن اکسایشی ATP</data>
  <data key="d1">method</data>
  <data key="d2">ساخت ATP از یون فسفات و انرژی انتقال الکترون‌ها در راکیزه.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-037&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-040</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ساخته شدن نوری ATP">
  <data key="d0">ساخته شدن نوری ATP</data>
  <data key="d1">method</data>
  <data key="d2">ساخت ATP در سبزدیسه (فصل ۶).&lt;SEP&gt;ساخت ATP در واکنش‌های نوری با عبور پروتون از آنزیم ATP‌ساز تیلاکوئید؛ فرایندی که با نور به راه می‌افتد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-037&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-049</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کربوهیدرات">
  <data key="d0">کربوهیدرات</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ترکیبات کربن، هیدروژن و اکسیژن با نقش انرژی‌زایی؛ مونوساکاریدها (گلوکز، فروکتوز)، دی‌ساکاریدها (ساکارز) و پلی‌ساکاریدها (سلولز، نشاسته، گلیکوژن).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-038</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ساکارز">
  <data key="d0">ساکارز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">دی‌ساکارید قند و شکر از گلوکز و فروکتوز.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-038</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اکسایش و کاهش">
  <data key="d0">اکسایش و کاهش</data>
  <data key="d1">concept</data>
  <data key="d2">از دست دادن الکترون اکسایش و گرفتن الکترون کاهش است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-038</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="NAD+">
  <data key="d0">NAD+</data>
  <data key="d1">naturalobject</data>
  <data key="d2">شکل اکسیدشدهٔ نیکوتین‌آمید آدنین دی‌نوکلئوتید که با کاهش به NADH تبدیل می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-038&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-042</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فروکتوز دوفسفاته">
  <data key="d0">فروکتوز دوفسفاته</data>
  <data key="d1">naturalobject</data>
  <data key="d2">حاصل گلوکز و دو ATP در قندکافت که به دو قند سه‌کربنی فسفاته تجزیه می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-038</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="غشای درونی راکیزه">
  <data key="d0">غشای درونی راکیزه</data>
  <data key="d1">naturalobject</data>
  <data key="d2">غشای چین‌خوردهٔ داخلی راکیزه.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-039&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-040</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فضای بین دو غشا">
  <data key="d0">فضای بین دو غشا</data>
  <data key="d1">naturalobject</data>
  <data key="d2">بخش بیرونی فضای راکیزه بین دو غشا.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-039</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کربس">
  <data key="d0">کربس</data>
  <data key="d1">person</data>
  <data key="d2">هانس آدولف کربس (۱۹۰۰–۱۹۸۱) کاشف مراحل اکسایش پیرووات و برندهٔ نوبل فیزیولوژی و پزشکی ۱۹۵۳.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-039</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گفتار ۲ اکسایش بیشتر">
  <data key="d0">گفتار ۲ اکسایش بیشتر</data>
  <data key="d1">content</data>
  <data key="d2">گفتار دوم فصل ۵: تجزیهٔ کامل گلوکز تا CO2 در چرخهٔ کربس و زنجیرهٔ انتقال الکترون.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-039</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="FAD">
  <data key="d0">FAD</data>
  <data key="d1">naturalobject</data>
  <data key="d2">شکل اکسیدشدهٔ حامل الکترون فلاوین آدنین دی‌نوکلئوتید.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-040</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="یون اکسید">
  <data key="d0">یون اکسید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">اکسیژن با دو بار منفی که با پروتون‌های بخش داخلی آب تشکیل می‌دهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-040</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="شیب غلظت پروتون">
  <data key="d0">شیب غلظت پروتون</data>
  <data key="d1">concept</data>
  <data key="d2">تراکم بیشتر پروتون در فضای بین دو غشا که انرژی ساخت ATP را فراهم می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-040</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="مروری بر تنفس یاخته‌ای">
  <data key="d0">مروری بر تنفس یاخته‌ای</data>
  <data key="d1">concept</data>
  <data key="d2">قندکافت در سیتوپلاسم پیرووات می‌سازد، پیرووات در راکیزه به استیل کوآنزیم A اکسید و وارد چرخهٔ کربس می‌شود؛ محصولات CO2، ATP، NADH، FADH2 و آب.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-041</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ویتامین‌های B">
  <data key="d0">ویتامین‌های B</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ویتامین‌هایی که به‌عنوان کوآنزیم در تنفس یاخته‌ای نقش دارند و برای سلامت مغز ضروری‌اند؛ B1 (تیامین) برای تشکیل استیل کوآنزیم A، B2 (ریبوفلاوین) و B3 (نیاسین).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-041</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="مغز">
  <data key="d0">مغز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">حدود ۲ درصد وزن بدن ولی بیش از ۲۰ درصد انرژی مصرفی؛ تغذیهٔ نامناسب با اثر بر ATP به کارکرد آن آسیب می‌زند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-041</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تنفس باکتری‌ها">
  <data key="d0">تنفس باکتری‌ها</data>
  <data key="d1">concept</data>
  <data key="d2">باکتری‌ها راکیزه ندارند؛ قندکافت و کربس در سیتوپلاسم؛ تا ۳۲ ATP به ازای هر گلوکز.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-041</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="منابع دیگر انرژی">
  <data key="d0">منابع دیگر انرژی</data>
  <data key="d1">concept</data>
  <data key="d2">در کمبود کربوهیدرات، چربی‌ها به اسید چرب و گلیسرول و پروتئین‌ها به آمینواسید تجزیه و در تنفس هوازی مصرف می‌شوند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-041</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تنظیم تنفس یاخته‌ای">
  <data key="d0">تنظیم تنفس یاخته‌ای</data>
  <data key="d1">concept</data>
  <data key="d2">تولید ATP تحت کنترل مقدار ATP و ADP است: ATP زیاد آنزیم‌های قندکافت و کربس را مهار و ADP زیاد آن‌ها را فعال می‌کند تا منابع هدر نروند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-042</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="بازده تنفس یاخته‌ای">
  <data key="d0">بازده تنفس یاخته‌ای</data>
  <data key="d1">data</data>
  <data key="d2">حداکثر ۳۰ ATP از هر گلوکز در یوکاریوت؛ انرژی گلوکز ۶۸۶ کیلوکالری بر مول و هر ATP حدود ۷٫۳؛ بازده حدود ۳۲ درصد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-042</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="سوء تغذیه">
  <data key="d0">سوء تغذیه</data>
  <data key="d1">event</data>
  <data key="d2">در کمبود گلوکز و ذخیرهٔ کبد، چربی‌ها و پروتئین‌ها تجزیه می‌شوند و ماهیچه‌های اسکلتی و دستگاه ایمنی تحلیل می‌روند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-042</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گفتار ۳ زیستن مستقل از اکسیژن">
  <data key="d0">گفتار ۳ زیستن مستقل از اکسیژن</data>
  <data key="d1">content</data>
  <data key="d2">گفتار سوم فصل ۵: تخمیر و پاداکسنده‌ها.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-042</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تخمیر الکلی">
  <data key="d0">تخمیر الکلی</data>
  <data key="d1">method</data>
  <data key="d2">پیرووات با از دست دادن CO2 به اتانال و اتانال با گرفتن الکترون NADH به اتانول تبدیل می‌شود؛ عامل ورآمدن خمیر نان.&lt;SEP&gt;گلوکز → پیرووات → اتانال (با آزاد شدن CO2) → اتانول (با NADH).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-042&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تخمیر لاکتیکی">
  <data key="d0">تخمیر لاکتیکی</data>
  <data key="d1">method</data>
  <data key="d2">در کمبود اکسیژن در ماهیچه، پیرووات با گرفتن الکترون NADH به الکتات تبدیل می‌شود؛ باکتری‌ها در ترش شدن شیر، لبنیات و خیارشور.&lt;SEP&gt;نوع دیگر تخمیر که الکتات می‌سازد؛ در صنایع استفاده می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-042&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اتانال">
  <data key="d0">اتانال</data>
  <data key="d1">naturalobject</data>
  <data key="d2">حاصل از دست دادن CO2 از پیرووات در تخمیر الکلی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اتانول">
  <data key="d0">اتانول</data>
  <data key="d1">naturalobject</data>
  <data key="d2">محصول نهایی تخمیر الکلی که در نان بر اثر حرارت تبخیر می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ساکارومایسس سرویزیه">
  <data key="d0">ساکارومایسس سرویزیه</data>
  <data key="d1">creature</data>
  <data key="d2">قارچ تک‌یاخته‌ای (مخمر نان) که نشاسته را تجزیه و با تخمیر الکلی CO2 می‌سازد و خمیر را ور می‌آورد؛ راکیزه دارد ولی می‌تواند تخمیر کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="الکتات">
  <data key="d0">الکتات</data>
  <data key="d1">naturalobject</data>
  <data key="d2">محصول تخمیر لاکتیکی که در ماهیچه در کمبود اکسیژن تجمع می‌یابد؛ علت ترش شدن شیر.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تخمیر در گیاهان">
  <data key="d0">تخمیر در گیاهان</data>
  <data key="d1">concept</data>
  <data key="d2">هر دو تخمیر الکلی و لاکتیکی در گیاهان در کمبود اکسیژن رخ می‌دهد؛ تجمع الکل یا الکتیک اسید یاخته را می‌کشد؛ گیاهان غرقابی پارانشیم هوادار و شش‌ریشه (حرا) دارند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="رادیکال آزاد">
  <data key="d0">رادیکال آزاد</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مولکول با الکترون جفت‌نشده و واکنش‌پذیری بالا که به بافت‌ها آسیب می‌زند؛ درصدی از اکسیژن در پایان زنجیرهٔ انتقال الکترون به رادیکال آزاد تبدیل می‌شود.&lt;SEP&gt;از عوامل ایجاد سرطان؛ اگر سرعت تشکیل آن از سرعت مبارزه بیشتر شود در راکیزه تجمع و آن را و یاخته را تخریب می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-044</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="پاداکسنده">
  <data key="d0">پاداکسنده</data>
  <data key="d1">naturalobject</data>
  <data key="d2">آنتی‌اکسیدان؛ ترکیبات محافظت‌کننده در برابر رادیکال‌های آزاد.&lt;SEP&gt;ترکیباتی مانند کاروتنوئیدها در میوه‌ها و سبزیجات که با واکنش با رادیکال‌های آزاد مانع تخریب مولکول‌های زیستی می‌شوند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-043&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-044</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کاروتنوئید">
  <data key="d0">کاروتنوئید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">رنگیزهٔ زرد، نارنجی و قرمز در غشای تیلاکوئید با بیشترین جذب در آبی و سبز.&lt;SEP&gt;رنگیزه و پاداکسندهٔ موجود در میوه‌ها و سبزیجات.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-044&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اثر الکل بر کبد">
  <data key="d0">اثر الکل بر کبد</data>
  <data key="d1">event</data>
  <data key="d2">الکل تشکیل رادیکال آزاد را زیاد و عملکرد راکیزه را مختل می‌کند؛ حمله به DNA راکیزه باعث مرگ یاخته‌های کبدی و نکروز کبد می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-044&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="نقص ژنی زنجیرهٔ انتقال الکترون">
  <data key="d0">نقص ژنی زنجیرهٔ انتقال الکترون</data>
  <data key="d1">event</data>
  <data key="d2">نقص ژن‌های پروتئین‌های زنجیره که پروتئین معیوب و ناتوانی راکیزه در مبارزه با رادیکال‌ها ایجاد می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-044</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تنفس یاخته‌ای بی‌هوازی">
  <data key="d0">تنفس یاخته‌ای بی‌هوازی</data>
  <data key="d1">method</data>
  <data key="d2">تنفس برخی باکتری‌ها در محیط بدون اکسیژن که گیرندهٔ نهایی الکترون مادهٔ معدنی مثل سولفات است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-044</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="هیدروژن سیانید">
  <data key="d0">هیدروژن سیانید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">سلاح شیمیایی به کار رفته توسط رژیم بعث عراق علیه ایران که با توقف زنجیرهٔ انتقال الکترون مرگی شبیه خفگی ایجاد می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-044</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="سیانید">
  <data key="d0">سیانید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">سمی که واکنش نهایی انتقال الکترون به O2 را مهار و زنجیرهٔ انتقال الکترون را متوقف می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-044</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="سیروز کبدی">
  <data key="d0">سیروز کبدی</data>
  <data key="d1">event</data>
  <data key="d2">از عوارض مصرف درازمدت الکل با تجمع چربی در یاخته‌های کبدی؛ احتمال سرطان کبد را افزایش می‌دهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فصل ۶ از انرژی به ماده">
  <data key="d0">فصل ۶ از انرژی به ماده</data>
  <data key="d1">content</data>
  <data key="d2">فصل ششم زیست ۳: فتوسنتز و منشأ انرژی ذخیره‌شده در مواد آلی؛ طرح سؤال محاسباتی ممنوع است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فتوسنتز">
  <data key="d0">فتوسنتز</data>
  <data key="d1">method</data>
  <data key="d2">تبدیل CO2 به مادهٔ آلی با انرژی نور خورشید و تولید اکسیژن: 6CO2 + 6H2O → C6H12O6 + 6O2؛ میزان آن با CO2 مصرفی یا O2 تولیدی اندازه‌گیری می‌شود؛ نیاز به رنگیزه و سامانهٔ تبدیل انرژی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="برگ">
  <data key="d0">برگ</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مناسب‌ترین ساختار برای فتوسنتز با سبزدیسهٔ فراوان؛ در دولپه‌ای‌ها پهنک و دمبرگ دارد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="پهنک">
  <data key="d0">پهنک</data>
  <data key="d1">naturalobject</data>
  <data key="d2">شامل روپوست، میانبرگ و دسته‌های آوندی (رگبرگ).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="میانبرگ">
  <data key="d0">میانبرگ</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌های پارانشیمی نرده‌ای (فشرده، زیر روپوست رویی) و اسفنجی (به سمت روپوست زیرین)؛ در برخی گیاهان (تک‌لپه) فقط اسفنجی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="یاختهٔ غلاف آوندی">
  <data key="d0">یاختهٔ غلاف آوندی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌های اطراف رگبرگ.&lt;SEP&gt;در گیاهان C4 سبزدیسه دارد و محل چرخهٔ کالوین است؛ در C3 سبزدیسه ندارد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-045&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-051</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="سبزدیسه">
  <data key="d0">سبزدیسه</data>
  <data key="d1">naturalobject</data>
  <data key="d2">کلروپلاست؛ غشای بیرونی و درونی و سامانهٔ غشایی تیلاکوئید که فضا را به درون تیلاکوئید و بستره تقسیم می‌کند؛ بستره دنا، رنا و رناتن دارد و سبزدیسه مستقل تقسیم می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-045</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تیلاکوئید">
  <data key="d0">تیلاکوئید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">ساختارهای غشایی کیسه‌مانند متصل به هم که رنگیزه‌های فتوسنتزی و فتوسیستم‌ها در غشای آن‌اند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-048</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="بستره">
  <data key="d0">بستره</data>
  <data key="d1">naturalobject</data>
  <data key="d2">فضای درون سبزدیسه بیرون تیلاکوئیدها با دنا، رنا و رناتن.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-049</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="سبزینهٔ a و b">
  <data key="d0">سبزینهٔ a و b</data>
  <data key="d1">naturalobject</data>
  <data key="d2">رنگیزه‌های گیاهی با بیشترین جذب در ۴۰۰–۵۰۰ (بنفش-آبی) و ۶۰۰–۷۰۰ نانومتر (نارنجی-قرمز).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فتوسیستم">
  <data key="d0">فتوسیستم</data>
  <data key="d1">concept</data>
  <data key="d2">سامانهٔ تبدیل انرژی شامل آنتن‌های گیرندهٔ نور (کلروفیل، کاروتنوئید و پروتئین) و یک مرکز واکنش با کلروفیل a در بستر پروتئینی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="مرکز واکنش">
  <data key="d0">مرکز واکنش</data>
  <data key="d1">concept</data>
  <data key="d2">کلروفیل a در فتوسیستم ۱ با حداکثر جذب ۷۰۰ (P700) و در فتوسیستم ۲ با ۶۸۰ نانومتر (P680).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ناقل الکترون">
  <data key="d0">ناقل الکترون</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مولکول‌هایی در غشای تیلاکوئید که فتوسیستم‌ها را به هم مرتبط و الکترون می‌گیرند یا می‌دهند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گوناگونی شکل برگ">
  <data key="d0">گوناگونی شکل برگ</data>
  <data key="d1">concept</data>
  <data key="d2">برگ ذرت دمبرگ ندارد؛ برگ گردو مرکب؛ لبهٔ برگ بلوط کنگره‌دار.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="طیف الکترومغناطیس">
  <data key="d0">طیف الکترومغناطیس</data>
  <data key="d1">concept</data>
  <data key="d2">نور مرئی بخش کوچکی از آن است؛ از پرتو گاما پرانرژی تا موج رادیویی کم‌انرژی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="آزمایش اسپیروژیر">
  <data key="d0">آزمایش اسپیروژیر</data>
  <data key="d1">event</data>
  <data key="d2">جلبک رشته‌ای اسپیروژیر با باکتری‌های هوازی در برابر نور تجزیه‌شده با منشور قرار گرفت و باکتری‌ها در بخش‌هایی تجمع یافتند؛ نشان داد طول موج‌ها به یک اندازه در فتوسنتز مؤثر نیستند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اسپیروژیر">
  <data key="d0">اسپیروژیر</data>
  <data key="d1">creature</data>
  <data key="d2">جلبک سبز رشته‌ای با سبزدیسه‌های نواری و دراز.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="سبزینه">
  <data key="d0">سبزینه</data>
  <data key="d1">naturalobject</data>
  <data key="d2">کلروفیل؛ مولکول با سر و دم؛ سبزینهٔ a و b در بخش سر اندکی تفاوت دارند؛ بخش سر شبیه هم در هموگلوبین ولی به‌جای آهن منیزیم دارد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گفتار ۲ واکنش‌های فتوسنتزی">
  <data key="d0">گفتار ۲ واکنش‌های فتوسنتزی</data>
  <data key="d1">content</data>
  <data key="d2">گفتار دوم فصل ۶: واکنش‌های وابسته به نور و مستقل از نور.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="واکنش‌های وابسته به نور">
  <data key="d0">واکنش‌های وابسته به نور</data>
  <data key="d1">method</data>
  <data key="d2">واکنش‌های تیلاکوئیدی که با تابش نور به رنگیزه‌ها الکترون برانگیخته ایجاد می‌کنند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="الکترون برانگیخته">
  <data key="d0">الکترون برانگیخته</data>
  <data key="d1">concept</data>
  <data key="d2">الکترون پرانرژی خارج‌شده از مدار که انرژی را به رنگیزهٔ بعدی می‌دهد یا از رنگیزه خارج می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فتوسیستم ۲">
  <data key="d0">فتوسیستم ۲</data>
  <data key="d1">naturalobject</data>
  <data key="d2">الکترون برانگیختهٔ آن پس از زنجیرهٔ انتقال الکترون به مرکز واکنش فتوسیستم ۱ می‌رود.&lt;SEP&gt;سبزینهٔ a آن (P680) کمبود الکترون خود را با تجزیهٔ نوری آب جبران می‌کند؛ در دههٔ ۵۰ میلادی و پس از فتوسیستم ۱ کشف شد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-048&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فتوسیستم ۱">
  <data key="d0">فتوسیستم ۱</data>
  <data key="d1">naturalobject</data>
  <data key="d2">الکترون برانگیختهٔ آن در نهایت به NADP+ می‌رسد.&lt;SEP&gt;کمبود الکترون سبزینهٔ a آن با الکترون فتوسیستم ۲ جبران می‌شود؛ زودتر کشف شد و نامش ۱ است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-048&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-046</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="NADPH">
  <data key="d0">NADPH</data>
  <data key="d1">naturalobject</data>
  <data key="d2">حاصل گرفتن دو الکترون و پروتون توسط NADP+.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-047&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-048&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-049</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تجزیهٔ نوری آب">
  <data key="d0">تجزیهٔ نوری آب</data>
  <data key="d1">method</data>
  <data key="d2">تجزیهٔ آب در فتوسیستم ۲ در سطح داخلی تیلاکوئید به الکترون، پروتون و اکسیژن؛ الکترون‌ها کمبود سبزینهٔ a مرکز واکنش فتوسیستم ۲ را جبران و پروتون‌ها در فضای درون تیلاکوئید تجمع می‌یابند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-048</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="پمپ پروتون تیلاکوئید">
  <data key="d0">پمپ پروتون تیلاکوئید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پروتئین زنجیرهٔ انتقال الکترون بین فتوسیستم ۲ و ۱ که H+ را از بستره به فضای درون تیلاکوئید پمپ می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-048</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="شیب پروتون تیلاکوئید">
  <data key="d0">شیب پروتون تیلاکوئید</data>
  <data key="d1">concept</data>
  <data key="d2">تراکم بیشتر پروتون در فضای درون تیلاکوئید نسبت به بستره که با تجزیهٔ آب و پمپ ایجاد می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-048</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="NADP+">
  <data key="d0">NADP+</data>
  <data key="d1">naturalobject</data>
  <data key="d2">نیکوتین‌آمید آدنین دی‌نوکلئوتید فسفات؛ پذیرندهٔ نهایی الکترون در واکنش‌های نوری.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-048</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="واکنش‌های مستقل از نور">
  <data key="d0">واکنش‌های مستقل از نور</data>
  <data key="d1">method</data>
  <data key="d2">واکنش‌های تثبیت کربن در بستره که انرژی و الکترون را از واکنش‌های نوری (ATP و NADPH) می‌گیرند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-049</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ریبولوزبیس‌فسفات">
  <data key="d0">ریبولوزبیس‌فسفات</data>
  <data key="d1">naturalobject</data>
  <data key="d2">قند پنج‌کربنه‌ای که CO2 را در چرخهٔ کالوین می‌پذیرد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-049</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تثبیت کربن">
  <data key="d0">تثبیت کربن</data>
  <data key="d1">method</data>
  <data key="d2">استفاده از CO2 برای تشکیل ترکیبات آلی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-049</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اثر محیط بر فتوسنتز">
  <data key="d0">اثر محیط بر فتوسنتز</data>
  <data key="d1">concept</data>
  <data key="d2">میزان CO2، طول موج، شدت و مدت تابش نور، دما (چون آنزیمی است) و میزان اکسیژن بر فتوسنتز اثر دارند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کالوین">
  <data key="d0">کالوین</data>
  <data key="d1">person</data>
  <data key="d2">ملوین الیس کالوین (۱۹۱۱–۱۹۹۷) زیست‌شیمی‌دان که با ردیابی کربن ۱۴ در جلبک سبز تک‌یاخته‌ای مراحل فتوسنتز را شناسایی و نوبل شیمی ۱۹۶۱ را گرفت.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کربن ۱۴">
  <data key="d0">کربن ۱۴</data>
  <data key="d1">naturalobject</data>
  <data key="d2">مادهٔ پرتوزا برای ردیابی مراحل فتوسنتز.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="گفتار ۳ فتوسنتز در شرایط دشوار">
  <data key="d0">گفتار ۳ فتوسنتز در شرایط دشوار</data>
  <data key="d1">content</data>
  <data key="d2">گفتار سوم فصل ۶: تنفس نوری، گیاهان C4 و CAM.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="بسته شدن روزنه">
  <data key="d0">بسته شدن روزنه</data>
  <data key="d1">event</data>
  <data key="d2">افزایش بیش از حد دما و نور روزنه‌ها را برای کاهش تعرق می‌بندد؛ CO2 برگ کم و O2 زیاد می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فایدهٔ تنفس نوری">
  <data key="d0">فایدهٔ تنفس نوری</data>
  <data key="d1">concept</data>
  <data key="d2">گیاهان فاقد تنفس نوری از نور شدید آسیب بیشتری می‌بینند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-050</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="فسفوانول‌پیرووات کربوکسیلاز">
  <data key="d0">فسفوانول‌پیرووات کربوکسیلاز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">آنزیم C4 که به‌طور اختصاصی با CO2 عمل می‌کند و تمایلی به اکسیژن ندارد؛ اسید چهارکربنی (مالات یا اگزالات) می‌سازد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-051</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="پلاسمودسم">
  <data key="d0">پلاسمودسم</data>
  <data key="d1">naturalobject</data>
  <data key="d2">راه انتقال اسید چهارکربنی از میانبرگ به غلاف آوندی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-051</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="آناناس">
  <data key="d0">آناناس</data>
  <data key="d1">creature</data>
  <data key="d2">نمونهٔ گیاه CAM.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-051</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="مقایسهٔ فتوسنتز C3، C4 و CAM">
  <data key="d0">مقایسهٔ فتوسنتز C3، C4 و CAM</data>
  <data key="d1">data</data>
  <data key="d2">گل رز C3، ذرت C4 (تقسیم مکانی میانبرگ و غلاف آوندی) و آناناس CAM (تقسیم زمانی شب و روز)؛ عصارهٔ CAM در آغاز روشنایی اسیدی‌تر است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="ذرت">
  <data key="d0">ذرت</data>
  <data key="d1">creature</data>
  <data key="d2">نمونهٔ گیاه C4.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="تاج خروس">
  <data key="d0">تاج خروس</data>
  <data key="d1">creature</data>
  <data key="d2">گیاه دولپه‌ای C4.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="جانداران فتوسنتزکنندهٔ دیگر">
  <data key="d0">جانداران فتوسنتزکنندهٔ دیگر</data>
  <data key="d1">concept</data>
  <data key="d2">بخش عمدهٔ فتوسنتز را باکتری‌ها و آغازیان خشکی و آبی انجام می‌دهند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="باکتری‌های گوگردی ارغوانی و سبز">
  <data key="d0">باکتری‌های گوگردی ارغوانی و سبز</data>
  <data key="d1">creature</data>
  <data key="d2">فتوسنتزکنندهٔ غیراکسیژن‌زا با رنگیزهٔ باکتریوکلروفیل که منبع الکترون آن‌ها H2S است و به‌جای اکسیژن گوگرد تولید می‌کنند؛ در تصفیهٔ فاضلاب برای حذف هیدروژن سولفید.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="باکتریوکلروفیل">
  <data key="d0">باکتریوکلروفیل</data>
  <data key="d1">naturalobject</data>
  <data key="d2">رنگیزهٔ فتوسنتزی باکتری‌های گوگردی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="هیدروژن سولفید">
  <data key="d0">هیدروژن سولفید</data>
  <data key="d1">naturalobject</data>
  <data key="d2">H2S؛ گاز بی‌رنگ با بوی تخم‌مرغ گندیده؛ منبع الکترون باکتری‌های گوگردی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-052&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="آغازیان فتوسنتزکننده">
  <data key="d0">آغازیان فتوسنتزکننده</data>
  <data key="d1">creature</data>
  <data key="d2">جلبک‌های سبز، قرمز و قهوه‌ای و اوگلنا که مادهٔ آلی از مادهٔ معدنی می‌سازند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="اوگلنا">
  <data key="d0">اوگلنا</data>
  <data key="d1">creature</data>
  <data key="d2">آغازی تک‌یاخته‌ای که در نور فتوسنتز می‌کند و در تاریکی سبزدیسه‌ها را از دست داده و از مواد آلی تغذیه می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="شیمیوسنتز">
  <data key="d0">شیمیوسنتز</data>
  <data key="d1">method</data>
  <data key="d2">ساخت مادهٔ آلی از مادهٔ معدنی با انرژی واکنش‌های اکسایش بدون نیاز به نور؛ توسط باکتری‌ها در معادن، اعماق اقیانوس و دهانهٔ آتشفشان‌های زیرآب.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="باکتری‌های شیمیوسنتزکننده">
  <data key="d0">باکتری‌های شیمیوسنتزکننده</data>
  <data key="d1">creature</data>
  <data key="d2">از قدیمی‌ترین جانداران زمین؛ مثل باکتری‌های نیترات‌ساز و باکتری‌های همزیست کرم‌های لوله‌ای.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="باکتری‌های نیترات‌ساز">
  <data key="d0">باکتری‌های نیترات‌ساز</data>
  <data key="d1">creature</data>
  <data key="d2">باکتری‌های شیمیوسنتزکننده که آمونیوم را به نیترات تبدیل می‌کنند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
  <data key="d6"></data>
</node>
<node id="کرم‌های لوله‌ای">
  <data key="d0">کرم‌های لوله‌ای</data>
  <data key="d1">creature</data>
  <data key="d2">کرم‌های اعماق اقیانوس که به غذای باکتری‌های شیمیوسنتزکنندهٔ همزیست (اکسیدکنندهٔ هیدروژن سولفید) وابسته‌اند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="فصل ۷ فناوری‌های نوین زیستی">
  <data key="d0">فصل ۷ فناوری‌های نوین زیستی</data>
  <data key="d1">content</data>
  <data key="d2">فصل هفتم زیست ۳: زیست‌فناوری، مهندسی ژنتیک و مهندسی پروتئین و کاربردها و اخلاق آن؛ مثال پلاستیک‌های زیست‌تجزیه‌پذیر با انتقال ژن باکتری به گیاه.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="زیست‌فناوری">
  <data key="d0">زیست‌فناوری</data>
  <data key="d1">method</data>
  <data key="d2">شامل مهندسی ژنتیک، مهندسی پروتئین و بافت؛ از علوم زیستی، فیزیک، ریاضی و مهندسی بهره می‌برد؛ فرهنگستان علوم: «تولید فراورده‌ها از طریق فرایند زیستی که مستلزم فنون مهندسی است».&lt;SEP&gt;هرگونه فعالیت هوشمندانهٔ آدمی در تولید و بهبود محصولات با استفاده از موجود زنده.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-054</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="مهندسی ژنتیک">
  <data key="d0">مهندسی ژنتیک</data>
  <data key="d1">method</data>
  <data key="d2">انتقال قطعه‌ای از دنای یک یاخته توسط ناقل به یاختهٔ دیگر؛ امکان ساخت پروتئین انسانی مثل هورمون رشد و عوامل انعقادی در باکتری.&lt;SEP&gt;انتقال قطعه دنا با ناقل به یاختهٔ دیگر که دست‌ورزی ژنتیکی و صفت جدید ایجاد می‌کند؛ ابتدا با باکتری‌ها و سپس گیاهان و جانوران.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-053&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-054&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-055</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="زیست‌فناوری سنتی">
  <data key="d0">زیست‌فناوری سنتی</data>
  <data key="d1">event</data>
  <data key="d2">تولید محصولات تخمیری مانند سرکه، نان و لبنیات.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-054</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="زیست‌فناوری کلاسیک">
  <data key="d0">زیست‌فناوری کلاسیک</data>
  <data key="d1">event</data>
  <data key="d2">تولید پادزیست‌ها، آنزیم‌ها و مواد غذایی با تخمیر و کشت ریزجانداران.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-054</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="زیست‌فناوری نوین">
  <data key="d0">زیست‌فناوری نوین</data>
  <data key="d1">event</data>
  <data key="d2">دوره‌ای که با انتقال ژن از یک ریزجاندار به دیگری آغاز شد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-054</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="شاخه‌های رنگی زیست‌فناوری">
  <data key="d0">شاخه‌های رنگی زیست‌فناوری</data>
  <data key="d1">concept</data>
  <data key="d2">سبز کشاورزی، قرمز پزشکی و قضایی، خاکستری محیط‌زیست، سفید صنعتی و آبی دریایی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-054</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="جاندار تراژنی">
  <data key="d0">جاندار تراژنی</data>
  <data key="d1">creature</data>
  <data key="d2">جاندار تغییریافتهٔ ژنتیکی (GMO) با ترکیب جدید مواد ژنتیکی از مهندسی ژنتیک.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-054</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="مراحل تولید گیاه تراژنی">
  <data key="d0">مراحل تولید گیاه تراژنی</data>
  <data key="d1">data</data>
  <data key="d2">۱) تعیین صفت مطلوب ۲) استخراج ژن ۳) آماده‌سازی و انتقال ژن به گیاه ۴) تولید گیاه تراژنی ۵) بررسی ایمنی زیستی ۶) تکثیر و کشت با رعایت ایمنی زیستی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="همسانه‌سازی دنا">
  <data key="d0">همسانه‌سازی دنا</data>
  <data key="d1">method</data>
  <data key="d2">جداسازی یک یا چند ژن و تکثیر آن‌ها با ناقل همسانه‌سازی در ژنوم میزبان برای تولید مقادیر زیاد دنای خالص.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-056&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-059</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="EcoRI">
  <data key="d0">EcoRI</data>
  <data key="d1">naturalobject</data>
  <data key="d2">آنزیم برش‌دهنده که توالی شش‌جفتی GAATTC را شناسایی و پیوند فسفودی‌استر بین G و A هر دو رشته را برش می‌دهد و انتهای چسبنده ایجاد می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="جایگاه تشخیص">
  <data key="d0">جایگاه تشخیص</data>
  <data key="d1">concept</data>
  <data key="d2">توالی که آنزیم برش‌دهنده شناسایی می‌کند و در دو رشته از دو سمت مخالف یکسان خوانده می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="انتهای چسبنده">
  <data key="d0">انتهای چسبنده</data>
  <data key="d1">concept</data>
  <data key="d2">انتهای دنا که یک رشته بلندتر از رشتهٔ مقابل است؛ با شکستن فسفودی‌استر و پیوندهای هیدروژنی ایجاد می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="دنای نوترکیب">
  <data key="d0">دنای نوترکیب</data>
  <data key="d1">naturalobject</data>
  <data key="d2">حاصل اتصال قطعه دنای جداشده به ناقل همسانه‌سازی.&lt;SEP&gt;مجموعهٔ دنای ناقل و ژن جاگذاری‌شده؛ دیسک و قطعهٔ خارجی باید با همان آنزیم برش‌دهنده بریده شوند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="ناقل همسانه‌سازی">
  <data key="d0">ناقل همسانه‌سازی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">توالی دنای خارج فام‌تنی که مستقل از فام‌تن اصلی تکثیر می‌شود، مثل دیسک.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-055&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="ژن مقاومت به پادزیست">
  <data key="d0">ژن مقاومت به پادزیست</data>
  <data key="d1">concept</data>
  <data key="d2">ژن دیسک که به باکتری توانایی تبدیل پادزیست به مواد غیرکشنده می‌دهد؛ در جداسازی یاخته‌های تراژنی مهم است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-056&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-057</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="آنزیم لیگاز">
  <data key="d0">آنزیم لیگاز</data>
  <data key="d1">naturalobject</data>
  <data key="d2">آنزیم اتصال‌دهنده که پیوند فسفودی‌استر بین دو انتهای چسبندهٔ مکمل دیسک و دنای خارجی ایجاد می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="وارد کردن دنای نوترکیب به یاختهٔ میزبان">
  <data key="d0">وارد کردن دنای نوترکیب به یاختهٔ میزبان</data>
  <data key="d1">method</data>
  <data key="d2">ایجاد منافذ در دیوارهٔ باکتری با شوک الکتریکی یا حرارتی همراه با مواد شیمیایی؛ همهٔ باکتری‌ها دنای نوترکیب را دریافت نمی‌کنند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="باکتری‌خوار">
  <data key="d0">باکتری‌خوار</data>
  <data key="d1">creature</data>
  <data key="d2">باکتریوفاژ؛ ویروس معمولاً دنادار که به باکتری حمله می‌کند؛ دنای آن به‌عنوان ناقل همسانه‌سازی قطعات بزرگ‌تری را جا می‌دهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="جایگاه شروع همانندسازی دیسک">
  <data key="d0">جایگاه شروع همانندسازی دیسک</data>
  <data key="d1">concept</data>
  <data key="d2">بخشی از دیسک که همانندسازی مستقل آن را ممکن می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-056</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="جداسازی یاخته‌های تراژنی">
  <data key="d0">جداسازی یاخته‌های تراژنی</data>
  <data key="d1">method</data>
  <data key="d2">کشت در محیط دارای پادزیست (مثل آمپی‌سیلین) که فقط باکتری‌های دارای دیسک نوترکیب با ژن مقاومت رشد می‌کنند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-057</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="آمپی‌سیلین">
  <data key="d0">آمپی‌سیلین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پادزیستی که ژن مقاومت به آن در دیسک برای جداسازی باکتری‌های تراژنی استفاده می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-057</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="گفتار ۲ فناوری مهندسی پروتئین و بافت">
  <data key="d0">گفتار ۲ فناوری مهندسی پروتئین و بافت</data>
  <data key="d1">content</data>
  <data key="d2">گفتار دوم فصل ۷.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-057</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="افزایش پایداری پروتئین">
  <data key="d0">افزایش پایداری پروتئین</data>
  <data key="d1">concept</data>
  <data key="d2">پایداری در برابر گرما سرعت واکنش را زیاد، آلودگی میکروبی را کم و نیاز به خنک کردن را برطرف می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-057</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="لخته در سرخرگ‌ها">
  <data key="d0">لخته در سرخرگ‌ها</data>
  <data key="d1">event</data>
  <data key="d2">لخته در سرخرگ‌های شش، مغز و ماهیچهٔ قلب باعث بسته شدن رگ‌های شش، سکتهٔ مغزی و قلبی می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-058</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="مهندسی بافت">
  <data key="d0">مهندسی بافت</data>
  <data key="d1">method</data>
  <data key="d2">کشت و تولید بافت و اعضا برای پیوند؛ مثل کشت پوست برای سوختگی وسیع و بازسازی لالهٔ گوش و بینی با غضروف روی داربست.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-058</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="یاخته‌های بنیادی">
  <data key="d0">یاخته‌های بنیادی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">یاخته‌هایی با توانایی تکثیر و تبدیل به انواع یاخته؛ جنینی (تودهٔ یاخته‌ای درونی) و بالغ.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-058</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="یاخته‌های بنیادی بالغ">
  <data key="d0">یاخته‌های بنیادی بالغ</data>
  <data key="d1">naturalobject</data>
  <data key="d2">در بافت‌ها مثل کبد (یاختهٔ کبدی یا مجرای صفراوی) و مغز استخوان (رگ، ماهیچهٔ اسکلتی و قلبی).</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-058</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="یاخته‌های بنیادی جنینی">
  <data key="d0">یاخته‌های بنیادی جنینی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">نه‌تنها همهٔ بافت‌های جنین را می‌سازند بلکه اگر در مراحل اولیه جدا شوند جنین کامل تشکیل می‌دهند؛ یاخته‌های مورولا به یاخته‌های جنینی و خارج‌جنینی (جفت و پرده‌ها) و تودهٔ درونی بلاستولا به یاخته‌های بدن جنین تمایز می‌یابند؛ تمایز آزمایشگاهی آن‌ها هنوز کامل تنظیم نمی‌شود.&lt;SEP&gt;تودهٔ یاخته‌ای درونی که همهٔ بافت‌های جنین را می‌سازد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-058&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-059</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="غضروف">
  <data key="d0">غضروف</data>
  <data key="d1">naturalobject</data>
  <data key="d2">بافتی که با مهندسی بافت روی داربست برای بازسازی گوش و بینی تولید می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-058</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="گفتار ۳ کاربردهای زیست‌فناوری">
  <data key="d0">گفتار ۳ کاربردهای زیست‌فناوری</data>
  <data key="d1">content</data>
  <data key="d2">گفتار سوم فصل ۷: کاربرد در کشاورزی، پزشکی و محیط‌زیست.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-059&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-060&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-061</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="کشاورزی نوین">
  <data key="d0">کشاورزی نوین</data>
  <data key="d1">concept</data>
  <data key="d2">افزایش محصولات گندم، برنج و ذرت با کود، سم، ماشین و افزایش سطح زیر کشت؛ با عواقب آلودگی، کاهش تنوع ژنی و تخریب جنگل‌ها.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-059</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="گیاه مقاوم به آفت">
  <data key="d0">گیاه مقاوم به آفت</data>
  <data key="d1">creature</data>
  <data key="d2">گیاه تراژنی (ذرت، پنبه، سویا) دارای ژن سم باکتری خاکزی که مصرف آفت‌کش را کاهش می‌دهد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-059</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="پیش‌سم باکتری خاکزی">
  <data key="d0">پیش‌سم باکتری خاکزی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">پروتئین سمی غیرفعال باکتری خاکزی که با آنزیم‌های گوارشی حشره فعال و یاخته‌های لولهٔ گوارش را تخریب می‌کند؛ به خود باکتری آسیب نمی‌زند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-059</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="پنبهٔ مقاوم">
  <data key="d0">پنبهٔ مقاوم</data>
  <data key="d1">creature</data>
  <data key="d2">پنبهٔ تراژنی که لارو آفت با خوردن آن پیش از ورود به غوزه می‌میرد و نیاز به سم‌پاشی کم می‌شود.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-059</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="کاربردهای زیست‌فناوری در کشاورزی">
  <data key="d0">کاربردهای زیست‌فناوری در کشاورزی</data>
  <data key="d1">concept</data>
  <data key="d2">اصلاح بذر، گیاهان مقاوم به خشکی، شوری و علف‌کش، تنظیم سرعت رسیدن میوه و افزایش ارزش غذایی.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="تولید دارو با دنای نوترکیب">
  <data key="d0">تولید دارو با دنای نوترکیب</data>
  <data key="d1">method</data>
  <data key="d2">داروهای مطمئن و مؤثر که برخلاف فراورده‌های غیرانسانی پاسخ ایمنی ایجاد نمی‌کنند؛ مثل انسولین.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="تولید انسولین با مهندسی ژنتیک">
  <data key="d0">تولید انسولین با مهندسی ژنتیک</data>
  <data key="d1">method</data>
  <data key="d2">در ۱۹۸۳ ژن‌های زنجیرهٔ A و B جداگانه در دیسک به باکتری منتقل، زنجیره‌ها خالص و در آزمایشگاه با پیوندهای شیمیایی متصل شدند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="زنجیرهٔ C">
  <data key="d0">زنجیرهٔ C</data>
  <data key="d1">naturalobject</data>
  <data key="d2">بخشی از پیش‌انسولین که جدا شدنش انسولین را فعال می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="دیابت نوع یک">
  <data key="d0">دیابت نوع یک</data>
  <data key="d1">event</data>
  <data key="d2">بیماری قابل کنترل با دریافت انسولین.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
<node id="واکسن نوترکیب">
  <data key="d0">واکسن نوترکیب</data>
  <data key="d1">method</data>
  <data key="d2">انتقال ژن پادگن سطحی عامل بیماری‌زا به باکتری یا ویروس غیربیماری‌زا؛ بدون خطر بروز بیماری؛ مثل واکسن هپاتیت B.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-060</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
</node>
