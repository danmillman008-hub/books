  <data key="d0">زنجیرهٔ بتای هموگلوبین</data>
  <data key="d1">naturalobject</data>
  <data key="d2">زنجیره‌ای که جهش ششمین آمینواسید آن باعث کم‌خونی داسی‌شکل است.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-027</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343199</data>
