  <data key="d3">doc-7aef00e820de0332e3e2bceb88d7e69c-chunk-027</data>
  <data key="d2">اوریک اسید نقرس و سنگ کلیه ایجاد می‌کند.</data>
  <data key="d1">UNKNOWN</data>
