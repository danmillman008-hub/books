<node id="ژنگان ماموت">
  <data key="d0">ژنگان ماموت</data>
  <data key="d1">event</data>
  <data key="d2">در ۲۰۰۸ ژنگان کامل ماموت به‌عنوان اولین گونهٔ منقرض تعیین شد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-061</data>
  <data key="d4">zist3_textbook.md</data>
  <data key="d5">1790343200</data>
  <data key="d6"></data>
