  <data key="d1">concept</data>
  <data key="d2">جهش جانشینی که رمز آمینواسید را به رمز پایان تبدیل و پلی‌پپتید را کوتاه می‌کند.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-028</data>
