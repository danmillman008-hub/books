<node id="رنای رناتنی">
  <data key="d0">رنای رناتنی</data>
  <data key="d1">naturalobject</data>
  <data key="d2">rRNA؛ همراه پروتئین در ساختار رناتن شرکت دارد.</data>
  <data key="d3">doc-44196875fe1b5053df21cd015b3e611e-chunk-004&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-015&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-013&lt;SEP&gt;doc-44196875fe1b5053df21cd015b3e611e-chunk-022</data>
  <data key="d4">zist3_textbook.md</data>
